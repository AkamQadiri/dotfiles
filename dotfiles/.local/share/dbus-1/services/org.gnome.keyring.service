# GNOME Keyring D-Bus Activation
# Start GNOME Keyring through its systemd unit, which the keyring control
# socket also starts, so a D-Bus request and the socket never start two daemons
[D-BUS Service]
Name=org.gnome.keyring
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
