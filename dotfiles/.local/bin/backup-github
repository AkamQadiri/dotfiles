#!/bin/bash
set -euo pipefail

# GitHub repository backup utility
# Clones all user repositories and archives them

# === GITHUB CONFIGURATION ===
# Uses the active gh account; gh supplies the credentials to git, so no token
# is ever written into a URL, the process list, or the cloned repositories.
GITHUB_USER=$(gh api user --jq .login 2>/dev/null) || {
    echo "Error: gh is not logged in (run 'gh auth login')"
    exit 1
}

# === BACKUP DRIVE ===
# Offer every filesystem that isn't part of the running system: not an EFI
# partition, and either unmounted or mounted where removable drives go
mapfile -t DRIVES < <(lsblk -Jpo NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,PARTTYPE | jq -r '
    .. | objects
    | select(.fstype != null and (.fstype | IN("swap", "crypto_LUKS", "LVM2_member", "linux_raid_member") | not))
    | select(.parttype != "c12a7328-f81f-11d2-ba4b-00a0c93ec93b")
    | select(.mountpoint == null or (.mountpoint | test("^/(run/media|media|mnt)/")))
    | "\(.name)  \(.size)  \(.fstype)  \(.label // "no label")  \(.mountpoint // "not mounted")"')

if [[ ${#DRIVES[@]} -eq 0 ]]; then
    echo "Error: No backup drive found (plug one in and try again)"
    exit 1
fi

echo "Choose the backup drive:"
PS3="Drive number: "
select drive in "${DRIVES[@]}"; do
    [[ -n "${drive}" ]] && break
    echo "Invalid choice"
done
[[ -n "${drive:-}" ]] || exit 1
BACKUP_DRIVE="${drive%% *}"

# === FETCH REPOSITORIES ===
echo "Fetching repository list for ${GITHUB_USER}..."
GITHUB_REPOS=$(gh api --paginate /user/repos --jq '.[].full_name') || {
    echo "Error: Failed to fetch repository list"
    exit 1
}

# === BACKUP CONFIGURATION ===
REPOS_DIR="/tmp/${GITHUB_USER}-repos"
# No colons, so the archive can be written to FAT, exFAT and NTFS drives
BACKUP_DATE=$(date +"%Y-%m-%dT%H%M%S%z")
ARCHIVE_NAME="${GITHUB_USER}-repos-${BACKUP_DATE}.tar.gz"
BACKUP_PATH="backup/github"

# === MOUNT MANAGEMENT ===
BACKUP_MOUNTPOINT=$(findmnt -nr -o target -S "${BACKUP_DRIVE}" || true)
SHOULD_UNMOUNT=false

if [[ -z "${BACKUP_MOUNTPOINT}" ]]; then
    echo "Mounting backup drive..."
    udisksctl mount -b "${BACKUP_DRIVE}" >/dev/null || {
        echo "Error: Failed to mount ${BACKUP_DRIVE}"
        exit 1
    }
    BACKUP_MOUNTPOINT=$(findmnt -nr -o target -S "${BACKUP_DRIVE}")
    SHOULD_UNMOUNT=true
fi

BACKUP_DESTINATION="${BACKUP_MOUNTPOINT}/${BACKUP_PATH}"

# === CLONE REPOSITORIES ===
echo "Creating temporary directory..."
rm -rf "${REPOS_DIR}"
mkdir -p "${REPOS_DIR}"

echo "Cloning repositories..."
while IFS= read -r repo; do
    echo "Cloning ${repo}..."
    # Bare: every branch and tag, without the working tree
    gh repo clone "${repo}" "${REPOS_DIR}/${repo}.git" --no-upstream -- --bare --quiet || {
        echo "Warning: Failed to clone ${repo}"
    }
done <<<"${GITHUB_REPOS}"

# === CREATE ARCHIVE ===
echo "Creating backup archive..."
mkdir -p "${BACKUP_DESTINATION}"
tar -czf "${BACKUP_DESTINATION}/${ARCHIVE_NAME}" \
    -C "${REPOS_DIR}" . \
    --force-local || {
    echo "Error: Failed to create archive"
    exit 1
}

# === CLEANUP ===
echo "Cleaning up..."
rm -rf "${REPOS_DIR}"

if [[ "${SHOULD_UNMOUNT}" == "true" ]]; then
    echo "Unmounting backup drive..."
    udisksctl unmount -b "${BACKUP_DRIVE}" >/dev/null
fi

echo "Backup complete: ${BACKUP_DESTINATION}/${ARCHIVE_NAME}"
