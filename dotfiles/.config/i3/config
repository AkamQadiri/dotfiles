# i3 Window Manager Configuration
# Documentation: https://i3wm.org/docs/userguide.html

# =============================================================================
# BASIC SETTINGS
# =============================================================================
set $mod Mod4

# Font for window titles and bar
font pango:monospace 12

# =============================================================================
# WINDOW SETTINGS  
# =============================================================================
# Borders
default_border none
default_floating_border none

# Gaps
gaps inner 15

# Window colors
# class                 border    backgr.   text      indicator child_border
client.focused          #6272a4   #6272a4   #f8f8f2   #6272a4   #6272a4
client.focused_inactive #44475a   #44475a   #f8f8f2   #44475a   #44475a  
client.unfocused        #282a36   #282a36   #bfbfbf   #282a36   #282a36
client.urgent           #44475a   #ff5555   #f8f8f2   #ff5555   #ff5555
client.placeholder      #282a36   #282a36   #f8f8f2   #282a36   #282a36
client.background       #f8f8f2

# =============================================================================
# WINDOW RULES
# =============================================================================
for_window [class="pavucontrol"] floating enable

# Flameshot places its capture window over the whole monitor itself, which
# i3 only allows for floating windows
for_window [class="flameshot"] floating enable

# The nnn preview leaves the focus on nnn (~/.config/nnn/preview-terminal)
no_focus [class="^nnn\.preview$"]

# =============================================================================
# MOUSE SETTINGS
# =============================================================================
# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Move tiling windows via drag & drop
tiling_drag modifier titlebar

# =============================================================================
# KEYBINDINGS
# =============================================================================

# Audio controls
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMute --release exec pkill -RTMIN+1 i3blocks
bindsym XF86AudioLowerVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioLowerVolume --release exec pkill -RTMIN+1 i3blocks  
bindsym XF86AudioRaiseVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioRaiseVolume --release exec pkill -RTMIN+1 i3blocks

# Brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessUp --release exec pkill -RTMIN+2 i3blocks
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessDown --release exec pkill -RTMIN+2 i3blocks

# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Notification controls
bindsym $mod+n exec dunstctl close
bindsym $mod+Shift+n exec dunstctl history-pop
bindsym $mod+Shift+period exec dunstctl context

# Application shortcuts
bindsym $mod+Shift+Return exec i3-sensible-terminal
bindsym $mod+Shift+c kill
bindsym $mod+p exec "rofi -modi drun,run -show drun"
bindsym $mod+c exec rofi -show calc -modi calc -no-show-match -no-sort -calc-command "printf '%s' '{result}' | xclip -selection clipboard"
bindsym $mod+e exec "rofi -show emoji -modi emoji"
bindsym Print exec "flameshot gui"

# Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Alternative focus movement (arrow keys)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Window movement  
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Alternative window movement (arrow keys)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout controls
bindsym $mod+z split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+t layout tabbed
bindsym $mod+s layout toggle split

# Floating controls
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Container focus
bindsym $mod+a focus parent

# =============================================================================
# WORKSPACES
# =============================================================================
# Default layout for new containers
workspace_layout tabbed

# Workspace definitions
set $ws1 "1: "
set $ws2 "2: "
set $ws3 "3: "
set $ws4 "4: "
set $ws5 "5: "

# Workspace switching
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Move workspace to output
bindsym $mod+x move workspace to output next

# Workspace monitor assignment
# 1-4 on the primary screen and 5 on the other, like a docked laptop's own
# screen; with one screen connected, every workspace opens on it
workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output nonprimary

# Application workspace assignment
# Spotify sets its class after the window appears, too late for assign
for_window [class="Spotify"] move container to workspace number $ws4
assign [class="discord"] $ws4
assign [class="Slack"] $ws4
assign [class="TelegramDesktop"] $ws4

# =============================================================================
# MODES
# =============================================================================
mode "resize" {
    # Vim keys
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    # Arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Main window: half the width, the windows beside it share the rest
    bindsym m resize set width 50 ppt, mode "default"

    # Exit resize mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# =============================================================================
# SYSTEM CONTROLS
# =============================================================================
# Restart i3 inplace
bindsym $mod+Shift+r restart

# Exit i3
bindsym $mod+Shift+q exit

# Lock screen
bindsym $mod+Shift+x exec loginctl lock-session

# =============================================================================
# BAR CONFIGURATION
# =============================================================================
bar {
    status_command i3blocks
    tray_output primary
    position top

    colors {
        background #282a36
        statusline #f8f8f2
        separator  #44475a

        focused_workspace  #6272a4 #6272a4 #f8f8f2
        active_workspace   #282a36 #44475a #f8f8f2
        inactive_workspace #282a36 #282a36 #bfbfbf
        urgent_workspace   #ff5555 #ff5555 #f8f8f2
        binding_mode       #ff5555 #ff5555 #f8f8f2
    }
}