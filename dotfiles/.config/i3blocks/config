# i3blocks Configuration
# Global properties
command=~/.config/i3blocks/scripts/$BLOCK_NAME
separator=false
separator_block_width=20
align=center

[cpu-usage]
interval=3

[memory-usage]
interval=3

[disk-usage]
interval=3

[network-status]
interval=3
signal=3
markup=pango

[bluetooth]
interval=3
markup=pango

[volume-control]
interval=once
signal=1

[power-profile]
interval=3

[battery]
interval=3

[clock]
interval=1
