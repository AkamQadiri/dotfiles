#!/bin/bash

# Clock indicator
# Shows time and date

# === HELPER FUNCTIONS ===
# Print this month's calendar from Monday, without its title or blank lines,
# with today in bold
calendar() {
    cal -m | sed -e '1d' -e '/^ *$/d' -e "s/\(^\| \)\($(printf '%(%-d)T')\)\( \|$\)/\1<b>\2<\/b>\3/"
}

# === HANDLE MOUSE CLICKS ===
# Programs run detached, as i3blocks ignores the block until a click finishes
# Button 1: Show calendar
# Button 2: Edit this script
case ${BLOCK_BUTTON} in
1) notify-send -a "clock" -h string:x-dunst-stack-tag:clock "$(printf '%(%B %Y)T')" "$(calendar)" ;;
2) setsid -f "${TERMINAL}" -e "${EDITOR}" "$0" >/dev/null 2>&1 ;;
esac

# === OUTPUT TIME AND DATE ===
printf ' %(%H:%M %d.%m)T\n'
