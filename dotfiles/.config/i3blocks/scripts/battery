#!/bin/sh

# Laptop battery indicator
# Shows charge level and charging status, hidden when no battery is present

# === GET BATTERY ===
# Use the first battery found
for battery_path in /sys/class/power_supply/BAT*; do
    break
done

# Exit if no battery is present
[ -d "$battery_path" ] || exit 0

# === HELPER FUNCTIONS ===
# Print time left and power draw while charging or discharging, from UPower,
# and the charge limit when the battery supports one
battery_details() {
    upower -i "/org/freedesktop/UPower/devices/battery_${battery_path##*/}" | awk -F': +' '
        $1 ~ /state$/ { state = $2 }
        $1 ~ /energy-rate$/ { rate = $2 + 0 }
        $1 ~ /time to empty$/ { time = $2 " left" }
        $1 ~ /time to full$/ { time = $2 " until full" }
        END {
            if (!time) time = "Estimating time"
            if (state == "discharging") printf "%s\nUsing %.1f W", time, rate
            else if (state == "charging") printf "%s\nCharging at %.1f W", time, rate
            else if (state == "fully-charged") printf "Fully charged"
            else printf "Plugged in, not charging"
        }'

    if read -r charge_stop <"$battery_path/charge_control_end_threshold" 2>/dev/null; then
        printf '\nCharge limit %s%%' "$charge_stop"
    fi
}

# Print a charge threshold (START or STOP) from TLP's running configuration
tlp_threshold() {
    sed -n "s/^$1_CHARGE_THRESH_${battery_path##*/}=\"\([0-9]*\)\"$/\1/p" /run/tlp/run.conf 2>/dev/null
}

# Switch between the TLP charge limit and charging to 100%, which TLP undoes
# once unplugged. The start threshold must stay below the end threshold, so it
# is written last when raising the limit and first when lowering it
toggle_full_charge() {
    limit_start=$(tlp_threshold START)
    limit_stop=$(tlp_threshold STOP)
    read -r charge_stop <"$battery_path/charge_control_end_threshold" 2>/dev/null || charge_stop=""

    if [ -z "$limit_start" ] || [ -z "$limit_stop" ] || [ -z "$charge_stop" ]; then
        message="No charge limit set in TLP"
    elif [ "$charge_stop" -lt 100 ]; then
        if { echo 100 >"$battery_path/charge_control_end_threshold" &&
            echo 0 >"$battery_path/charge_control_start_threshold"; } 2>/dev/null; then
            message="Charging to 100% until unplugged"
        else
            message="Could not change the charge limit"
        fi
    else
        if { echo "$limit_start" >"$battery_path/charge_control_start_threshold" &&
            echo "$limit_stop" >"$battery_path/charge_control_end_threshold"; } 2>/dev/null; then
            message="Charging between $limit_start% and $limit_stop%"
        else
            message="Could not change the charge limit"
        fi
    fi

    notify-send -a "battery" -h string:x-dunst-stack-tag:battery "Battery" "$message"
}

# === HANDLE MOUSE CLICKS ===
# Programs run detached, as i3blocks ignores the block until a click finishes
# Button 1: Show time left, power draw and charge limit
# Button 2: Edit this script
# Button 3: Toggle between the charge limit and a full charge
case $BLOCK_BUTTON in
1) notify-send -a "battery" -h string:x-dunst-stack-tag:battery "Battery" "$(battery_details)" ;;
2) setsid -f "$TERMINAL" -e "$EDITOR" "$0" >/dev/null 2>&1 ;;
3) toggle_full_charge ;;
esac

# === GET BATTERY STATUS ===
# Read charge level and charging status
read -r battery <"$battery_path/capacity"
read -r battery_status <"$battery_path/status"

# === DETERMINE ICON ===
# Select appropriate battery icon based on status
if [ "$battery_status" = "Charging" ]; then
    battery_icon=""
elif [ "$battery" -ge "90" ]; then
    battery_icon=""
elif [ "$battery" -ge "65" ]; then
    battery_icon=""
elif [ "$battery" -ge "40" ]; then
    battery_icon=""
elif [ "$battery" -ge "15" ]; then
    battery_icon=""
else
    battery_icon=""
fi

# === LOW BATTERY NOTIFICATION ===
# Notify once per level while discharging, reset when charging
notify_state="${XDG_RUNTIME_DIR:-/tmp}/battery-notify"
if [ "$battery_status" = "Discharging" ]; then
    if [ "$battery" -le "5" ]; then
        notify_level="critical"
    elif [ "$battery" -lt "15" ]; then
        notify_level="normal"
    else
        notify_level=""
    fi

    if [ -n "$notify_level" ] && [ "$(cat "$notify_state" 2>/dev/null)" != "$notify_level" ]; then
        notify-send -a "battery" -u "$notify_level" "Battery low" "$battery% remaining, plug in the charger"
        echo "$notify_level" >"$notify_state"
    fi
else
    rm -f "$notify_state"
fi

# === OUTPUT STATUS ===
echo "$battery_icon $battery%"

# Mark block urgent when low and discharging
[ "$battery_status" = "Discharging" ] && [ "$battery" -lt "15" ] && exit 33
exit 0
