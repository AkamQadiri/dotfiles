#!/bin/sh

# Power profile indicator
# Shows the active power profile, hidden when no profile daemon is available

# === HELPER FUNCTIONS ===
# Print the active profile from tlp-pd or power-profiles-daemon, which share
# this D-Bus interface (busctl prints it as: s "balanced")
get_profile() {
    active_profile=$(busctl get-property org.freedesktop.UPower.PowerProfiles \
        /org/freedesktop/UPower/PowerProfiles org.freedesktop.UPower.PowerProfiles \
        ActiveProfile 2>/dev/null) || return
    active_profile=${active_profile#s \"}
    echo "${active_profile%\"}"
}

# Switch to the given profile
set_profile() {
    busctl set-property org.freedesktop.UPower.PowerProfiles /org/freedesktop/UPower/PowerProfiles \
        org.freedesktop.UPower.PowerProfiles ActiveProfile s "$1"
}

# === GET ACTIVE PROFILE ===
# Exit if no profile daemon is running
profile=$(get_profile)
[ -n "$profile" ] || exit 0

# === HANDLE MOUSE CLICKS ===
# Programs run detached, as i3blocks ignores the block until a click finishes
# Button 1: Next profile
# Button 2: Edit this script
# Button 3: Previous profile
case $BLOCK_BUTTON in
1)
    case $profile in
    power-saver) next_profile="balanced" ;;
    balanced) next_profile="performance" ;;
    *) next_profile="power-saver" ;;
    esac
    ;;
2) setsid -f "$TERMINAL" -e "$EDITOR" "$0" >/dev/null 2>&1 ;;
3)
    case $profile in
    performance) next_profile="balanced" ;;
    balanced) next_profile="power-saver" ;;
    *) next_profile="performance" ;;
    esac
    ;;
esac

# === SWITCH PROFILE ===
# Profiles apply in the background, so trust a successful switch over a re-read
if [ -n "$next_profile" ] && set_profile "$next_profile"; then
    profile=$next_profile
    profile_switched=1
fi

# === DETERMINE ICON AND LABEL ===
# Select icon and label based on active profile
case $profile in
power-saver)
    profile_icon=""
    profile_label="Power saver"
    ;;
performance)
    profile_icon=""
    profile_label="Performance"
    ;;
*)
    profile_icon=""
    profile_label="Balanced"
    ;;
esac

# === SWITCH NOTIFICATION ===
# Replace the previous notification so quick clicks do not stack
if [ -n "$profile_switched" ]; then
    notify-send -a "power-profile" -h string:x-dunst-stack-tag:power-profile \
        "Power profile" "$profile_label"
fi

# === OUTPUT STATUS ===
echo "$profile_icon"
