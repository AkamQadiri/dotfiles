#!/bin/bash

# Bluetooth status indicator
# Shows Bluetooth state and connected device count, hidden when no adapter is present

# === GET ADAPTER ===
# Use the first adapter found
for adapter_path in /sys/class/bluetooth/hci*; do
    break
done

# Exit if no adapter is present
[[ -e "${adapter_path}" ]] || exit 0
adapter="${adapter_path##*/}"

# === HELPER FUNCTIONS ===
# Print whether the adapter is powered and how many devices are connected, in
# one query to bluetoothd (powered is false while Bluetooth is blocked)
adapter_status() {
    busctl --json=short call org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects 2>/dev/null |
        jq -r --arg path "/org/bluez/${adapter}" '.data[0]
            | [(.[$path]["org.bluez.Adapter1"].Powered.data // false),
               ([to_entries[] | select(.key | startswith($path + "/"))
                 | .value["org.bluez.Device1"].Connected.data // empty | select(.)] | length)]
            | @tsv'
}

# Wrap text in Pango markup that dims it
dim() {
    echo "<span foreground='#6272a4'>$1</span>"
}

# Toggle Bluetooth radio frequency blocking
toggle_bluetooth() {
    if [[ "${powered}" == "true" ]]; then
        rfkill block bluetooth
    else
        rfkill unblock bluetooth
        timeout 3 bluetoothctl power on >/dev/null
    fi
}

read -r powered connected < <(adapter_status)

# === HANDLE MOUSE CLICKS ===
# Button 1: Open Bluetooth manager
# Button 2: Edit this script
# Button 3: Toggle Bluetooth on/off
case ${BLOCK_BUTTON} in
1) "${TERMINAL}" -e "bluetui" ;;
2) "${TERMINAL}" -e "${EDITOR}" "$0" ;;
3)
    toggle_bluetooth
    read -r powered connected < <(adapter_status)
    ;;
esac

# === OUTPUT STATUS ===
# Dimmed icon when off, connected device count when any are connected
if [[ "${powered}" == "true" ]]; then
    if [[ "${connected}" -gt 0 ]]; then
        echo " ${connected}"
    else
        echo ""
    fi
else
    dim ""
fi
