#!/bin/sh

# Memory usage indicator
# Shows used/total memory

# === HANDLE MOUSE CLICKS ===
# Button 1: Open process viewer sorted by memory use
# Button 2: Edit this script
case $BLOCK_BUTTON in
1) "$TERMINAL" -e "htop" --sort-key PERCENT_MEM ;;
2) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# === OUTPUT MEMORY USAGE ===
echo " $(awk '
/^MemTotal:/ { total=$2 }
/^MemAvailable:/ { available=$2 }
END {
    used=(total-available)/1024/1024
    total_gb=total/1024/1024
    printf " %.1fG/%.1fG\n", used, total_gb
}' /proc/meminfo)"
