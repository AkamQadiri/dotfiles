#!/bin/sh

# Memory usage indicator
# Shows used/total memory

# === HANDLE MOUSE CLICKS ===
# Button 1: Open process viewer sorted by memory use
# Button 2: Edit this script
case $BLOCK_BUTTON in
1) "$TERMINAL" -e "htop" --sort-key PERCENT_MEM ;;
2) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# === GET MEMORY USAGE ===
# Read total and available memory in kB, stopping once both are found
while read -r key value _; do
    case $key in
    MemTotal:) total=$value ;;
    MemAvailable:)
        available=$value
        break
        ;;
    esac
done </proc/meminfo

# Convert to tenths of a GiB, rounded
used=$((((total - available) * 10 + 524288) / 1048576))
total=$(((total * 10 + 524288) / 1048576))

# === OUTPUT MEMORY USAGE ===
printf ' %s %d.%dG/%d.%dG\n' "" $((used / 10)) $((used % 10)) $((total / 10)) $((total % 10))
