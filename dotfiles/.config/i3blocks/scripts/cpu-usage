#!/bin/sh

# CPU usage indicator
# Shows current CPU usage percentage

# === HELPER FUNCTIONS ===
# Print the CPU package temperature from the Intel or AMD sensor
cpu_temperature() {
    for hwmon_path in /sys/class/hwmon/hwmon*; do
        read -r sensor <"$hwmon_path/name"
        case $sensor in
        coretemp | k10temp)
            read -r temperature <"$hwmon_path/temp1_input"
            echo "$((temperature / 1000))°C"
            return
            ;;
        esac
    done
    echo "No CPU sensor found"
}

# === HANDLE MOUSE CLICKS ===
# Programs run detached, as i3blocks ignores the block until a click finishes
# Button 1: Open process viewer
# Button 2: Edit this script
# Button 3: Show CPU temperature
case $BLOCK_BUTTON in
1) setsid -f "$TERMINAL" -e "htop" >/dev/null 2>&1 ;;
2) setsid -f "$TERMINAL" -e "$EDITOR" "$0" >/dev/null 2>&1 ;;
3)
    notify-send -a "cpu-usage" -h string:x-dunst-stack-tag:cpu-usage "CPU temperature" "$(cpu_temperature)"
    ;;
esac

# === GET CPU USAGE ===
# Read CPU stats and calculate usage since the previous update, kept in a state
# file, instead of sleeping between two samples
cpu_state="${XDG_RUNTIME_DIR:-/tmp}/cpu-usage"
read -r _ user nice system idle iowait irq softirq steal _ </proc/stat

# Calculate total from current sample
total=$((user + nice + system + idle + iowait + irq + softirq + steal))

# Read previous sample, zero on the first update to show usage since boot
prevtotal=0
previdle=0
[ -f "$cpu_state" ] && read -r prevtotal previdle cpu_usage <"$cpu_state"

# Calculate differences
totald=$((total - prevtotal))
idled=$((idle - previdle))

# Calculate CPU usage percentage, keeping the previous one when less than a
# second of CPU time (100 ticks) passed since the last update, like a click
# right after it, as such short samples are too noisy
if [ "$totald" -ge 100 ]; then
    cpu_usage=$((100 * (totald - idled) / totald))
    echo "$total $idle $cpu_usage" >"$cpu_state"
fi

# === OUTPUT CPU USAGE ===
echo " $cpu_usage%"
